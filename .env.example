# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Password gate. Set APP_PASSWORD and the whole app sits behind a sign-in page;
# leave it unset and the app is open, which is usually what you want locally.
APP_PASSWORD=
# Secret used to sign the session cookie. Any long random string.
# Generate one with:  openssl rand -hex 32
# If you leave it blank, APP_PASSWORD is used instead (changing the password
# then signs everyone out, which is the behaviour you want anyway).
AUTH_SECRET=
